{
  "name": "rocket-campus-pm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase and GitHub backed project management for student teams",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "bootstrap:admin": "node scripts/bootstrap-system-admin.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file supabase/.env.local"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@noble/hashes": "^1.8.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "supabase": "^2.39.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
